# Copy the values you need into apps/web/.env.local (gitignored). Never commit real secrets here.

# --- ACTIVE (this milestone) ---

# Neon Postgres — pooled connection, used at runtime by the Prisma Neon adapter
DATABASE_URL=

# Neon Postgres — unpooled/direct connection, used by the Prisma CLI for migrations
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated extra origins Better Auth should trust beyond the auto-detected
# VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL (e.g. a stable preview alias).
# Example: ADDITIONAL_TRUSTED_ORIGINS=https://bikie-web-rs8i.vercel.app
ADDITIONAL_TRUSTED_ORIGINS=

# Public app URL, used for server-side fetches to our own /api routes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When set, the OTP code is shown as a toast notification in the login/signup UI instead of
# only appearing in the server console. Useful for testing builds where Twilio isn't configured.
# Set to "false" to disable in real production.
SHOW_OTP_TOAST=true

# Twilio — sends OTP codes (phone+OTP login/signup) and SOS panic-alert SMS via SMSService
# (packages/services/src/sms.service.ts). If TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN plus one of
# TWILIO_MESSAGING_SERVICE_SID/TWILIO_FROM_NUMBER aren't set, SMSService logs
# "[SMS][DEV] To: ... | Message: ..." to the server console instead of sending a real SMS —
# safe for local dev, but real delivery needs the account SID/token plus a sender set below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set ONE of these two (Messaging Service is preferred if both are set — see Twilio Console >
# Messaging > Services for the "MG..." SID; use TWILIO_FROM_NUMBER only if you have a single
# dedicated phone number instead, Console > Phone Numbers > Manage > Active Numbers).
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- ACTIVE (Milestone 8 — Community Platform v2, see ADR-011) ---

# Chat message encryption (AES-256-GCM). 32 raw bytes, base64-encoded.
# Generate with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=

# Upstash Redis (REST client) — realtime pub/sub for chat/notifications/moderation events.
# If unset, realtime publishes/drains are silent no-ops (dev-safe fallback, see RealtimeService).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- FUTURE (documented only, not consumed by this milestone) ---

# Razorpay (payments — not wired yet)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Cloud Messaging (notifications — not wired yet)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Mapbox (maps — not wired yet)
NEXT_PUBLIC_MAPBOX_TOKEN=
