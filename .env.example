# Copy the values you need into apps/web/.env.local (gitignored). Never commit real secrets here.

# --- ACTIVE (this milestone) ---

# Neon Postgres — pooled connection, used at runtime by the Prisma Neon adapter
DATABASE_URL=

# Neon Postgres — unpooled/direct connection, used by the Prisma CLI for migrations
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (ADR-017) — a Better Auth social provider, NOT Firebase Authentication. From
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application),
# redirect URI http://localhost:3000/api/auth/callback/google. If unset, the `google` provider
# simply doesn't register (Better Auth logs a warning) — there's no dev-safe stub for this one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated extra origins Better Auth should trust beyond the auto-detected
# VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL (e.g. a stable preview alias).
# Example: ADDITIONAL_TRUSTED_ORIGINS=https://bikie-web-rs8i.vercel.app
ADDITIONAL_TRUSTED_ORIGINS=

# Public app URL, used for server-side fetches to our own /api routes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for Vercel cron-triggered routes (apps/web/app/api/cron/**) — each checks
# `Authorization: Bearer <CRON_SECRET>`. Generate with: openssl rand -base64 32
CRON_SECRET=

# When set to "true", the mobile OTP dev-bypass (ADR-034) skips MSG91 entirely and shows a
# locally-generated code as a toast on mobile (via /api/dev/otp). Opt-in only — unset/false
# disables it. Always blocked in production. Web has no equivalent since MSG91's Widget SDK talks
# to MSG91 directly from the browser, bypassing our backend for the send step (accepted regression,
# see ADR-034).
SHOW_OTP_TOAST=false

# TEST OTP bypass (ADR-047, extended by ADR-072) — a small allowlist of phone numbers that accept
# the single fixed TEST_OTP below without ever calling MSG91, for a specific Rider / Service
# Provider demo persona. Comma-separate multiple numbers per var if needed (E.164, e.g. +9198...).
#   - Outside production: always active (dev/QA convenience).
#   - In production (ADR-072): active ONLY because these vars are set. Play Store / App Store
#     review verifies the app against the production backend and cannot receive a real SMS, so a
#     dedicated non-privileged demo account reached by a fixed code is the only viable credential.
#     Blast radius = exactly these accounts (no admin, no real user data); the code alone is
#     useless without one of the exact numbers. Leave blank on any deploy that doesn't need it.
# The demo Rider / Service Provider accounts seeded by prisma/seed.ts are wired to these numbers
# (see DEMO_RIDER_PHONE / DEMO_PROVIDER_PHONE there). The two numbers MUST differ — a phoneNumber
# maps to exactly one account. The login screens call GET /api/auth-helpers/phone-exists BEFORE
# any OTP step, so the number only works once the demo account actually carries it: run
# `pnpm --filter @bikie/database db:seed` OR the scoped `db:patch:store-review` script.
TEST_RIDER_PHONE=
TEST_SERVICE_PROVIDER_PHONE=
TEST_OTP=

# ADR-072 — the web login page skips the MSG91 widget for a phone number in this client-visible
# allowlist and posts the typed code straight to the backend (which still checks it against
# TEST_OTP above). Set these to the SAME numbers as TEST_RIDER_PHONE / TEST_SERVICE_PROVIDER_PHONE.
# The numbers are public by design (they unlock only the demo accounts); TEST_OTP stays server-side.
NEXT_PUBLIC_TEST_RIDER_PHONE=
NEXT_PUBLIC_TEST_SERVICE_PROVIDER_PHONE=

# MSG91 — SOS panic-alert SMS via SMSService (packages/services/src/sms.service.ts). If
# MSG91_AUTH_KEY/MSG91_SENDER_ID aren't set, SMSService logs "[SMS][DEV] To: ... | Message: ..."
# to the server console instead of sending a real SMS — safe for local dev, but real delivery
# needs the auth key + sender ID below. (Phone-login OTP no longer goes through this path — see
# the MSG91 OTP block further down, ADR-034.)
# Optional shared timeout for provider HTTP (SMS/WhatsApp/Resend/etc.), milliseconds.
PROVIDER_HTTP_TIMEOUT_MS=10000
# Dashboard > API > Auth Key. Also used by the OTP block below (native OTP API + widget
# verifyAccessToken) — one account authkey, server-only, never sent to the client.
MSG91_AUTH_KEY=
# Dashboard > SMS > Sender ID — approved 6-char alphanumeric, DLT-registered for Indian routes.
MSG91_SENDER_ID=
# Transactional route (4) vs promotional (1) — SOS alerts should stay on transactional.
MSG91_ROUTE=4
# DLT template ID for the SOS alert SMS body — India's TRAI DLT rules require the SMS text to
# match a pre-registered template. Distinct from MSG91_OTP_TEMPLATE_ID below (OTP and SOS alerts
# use different text, so need their own registered templates).
MSG91_TEMPLATE_ID=
# ADR-058 — DLT template ID for the "BIKIE_Sub" Rider-membership-purchased confirmation SMS
# (Dashboard > SMS > DLT Templates > "BIKIE_Sub", Sender ID KSHIDL — same sender as
# MSG91_SENDER_ID above, only the template ID differs). Sent once, right after a Rider membership
# purchase succeeds (MembershipService.purchaseMembership) — never for a Service Provider
# membership, whose plan isn't annual (see SMSService.sendMembershipSubscribed's doc comment).
MSG91_MEMBERSHIP_SUB_TEMPLATE_ID=
# ADR-059 — DLT template ID for the "BIKIE_SR" SOS-help SMS (Dashboard > SMS > DLT Templates >
# "BIKIE_SR", Sender ID KSHIDL). Sent only to NEARBY_RIDER/SERVICE_PROVIDER SOS dispatch
# recipients, capped to the nearest 10 per dispatch batch (SOS_SMS_RECIPIENT_LIMIT,
# fan-out.application.ts) — MSG91 bills per message and the template names an actual rider.
MSG91_SOS_HELP_TEMPLATE_ID=

# MSG91 OTP (ADR-034) — MSG91 is the sole OTP generator on both platforms now: its Widget SDK on
# web, its native server-to-server OTP API on mobile (via /api/otp/mobile/send). Better Auth only
# asks MSG91 whether a code was right; it never generates one. See ADR-034 for the full design
# and ADR-032 for the (now superseded) prior decision.
# Dashboard > OTP > a DLT-approved template for OTP content specifically — NOT MSG91_TEMPLATE_ID
# above, which is registered for SOS alert text and will be rejected for OTP-shaped content.
MSG91_OTP_TEMPLATE_ID=
# Dashboard > OTP Widget > Widget ID/Token Auth. These ARE client-exposed by design — the widget
# is a browser <script> tag, so this value is visible in page source. It is not a secret the way
# MSG91_AUTH_KEY is; MSG91 scopes/restricts the widget by domain in its own dashboard, not by
# keeping this value hidden.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_WIDGET_TOKEN_AUTH=
# WhatsApp — Meta WhatsApp Cloud API is the preferred (direct) sender; Twilio below is only a
# fallback. Get both values from developers.facebook.com > your app > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
# Approved template used automatically when the 24h free-form window is closed. Its body must
# take a single {{1}} parameter. Leave blank while testing with numbers that replied recently.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Twilio WhatsApp sender — fallback only, used when the Cloud API vars above are blank.
# Example sandbox: whatsapp:+14155238886. If unset, WhatsAppService logs "[WHATSAPP][DEV] ..."
# with a wa.me click-to-send link.
TWILIO_WHATSAPP_FROM=

# Email — direct SMTP (your own mailbox, no third-party sending API). For Gmail use an
# App Password (myaccount.google.com > Security > 2-Step Verification > App passwords),
# not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@bikie.app

# Resend — optional hosted fallback, only used when SMTP_USER/SMTP_PASS are blank.
RESEND_API_KEY=

# SOS dispatch tuning (packages/services/src/sos-dispatch.service.ts)
# Radius in km for PostGIS nearby-rider lookup around the alert GPS (default 10).
SOS_NEARBY_RADIUS_KM=10
# Optional fixed emergency-services destination (SMS/WhatsApp/email). Leave blank in dev.
SOS_EMERGENCY_SERVICES_PHONE=
SOS_EMERGENCY_SERVICES_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- ACTIVE (ADR-016 — Nearby Riders, Nearby Help, Push Notifications) ---

# Google Places API (New) — server-only key, never exposed to the browser. Powers the SOS
# "Nearby Help" tab (petrol pump/mechanic/hospital search). If unset, PlacesService logs
# "[Places][DEV] ..." and returns an empty list instead of failing.
GOOGLE_PLACES_API_KEY=

# No env var needed for maps (ADR-036) — LocationPicker.tsx/PartnersMap.tsx use Leaflet + raw
# OpenStreetMap tiles, not Google Maps JS SDK. Zero setup cost; see ADR-036 for the fair-use
# caveat on OSM's public tile server if this app's map traffic grows significantly.

# Firebase Cloud Messaging — web push notifications, wired into every existing notification
# type via NotificationService. If FIREBASE_PROJECT_ID/FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY
# aren't all set, PushService logs "[Push][DEV] ..." instead of sending. Server (Admin SDK) —
# from a Firebase service account JSON key (Project Settings > Service accounts > Generate new
# private key). FIREBASE_PRIVATE_KEY keeps its literal \n newline escapes when pasted here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Client (Web SDK) — from Firebase Console > Project Settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# From Firebase Console > Project Settings > Cloud Messaging > Web configuration > Web Push
# certificates > Generate key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- ACTIVE (Milestone 8 — Community Platform v2, see ADR-011) ---

# Chat message encryption (AES-256-GCM). 32 raw bytes, base64-encoded.
# Generate with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=

# Upstash Redis (REST client) — realtime pub/sub for chat/notifications/moderation events,
# rate limits, and SOS dispatch idempotency.
# Strongly recommended in production: without it, rate limits and idempotency fall back to
# per-instance memory (degraded, never blocking — see ADR-029).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: when `true`, reserves async SOS fan-out enqueue path (default remains sync;
# HTTP response shape unchanged). See `isAsyncDispatchEnabled()` / ADR-027.
SOS_ASYNC_DISPATCH=

# --- ACTIVE (ADR-043 — Membership payments) ---

# Razorpay — server-side order creation + payment-signature verification
# (packages/services/src/razorpay.service.ts). If both are unset, membership purchase falls
# back to the pre-existing simulated checkout (no real charge, dummy paymentId) exactly as
# before this was wired — safe to leave blank in dev. The publishable key id doesn't need its
# own NEXT_PUBLIC_ var: it travels to the browser via the authenticated
# POST /api/membership/checkout response instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- FUTURE (documented only, not consumed by this milestone) ---

# Mapbox (maps — not wired yet)
NEXT_PUBLIC_MAPBOX_TOKEN=
