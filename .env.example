# Copy the values you need into apps/web/.env.local (gitignored). Never commit real secrets here.

# --- ACTIVE (this milestone) ---

# Neon Postgres — pooled connection, used at runtime by the Prisma Neon adapter
DATABASE_URL=

# Neon Postgres — unpooled/direct connection, used by the Prisma CLI for migrations
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Public app URL, used for server-side fetches to our own /api routes
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- FUTURE (documented only, not consumed by this milestone) ---

# Razorpay (payments — not wired yet)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Cloud Messaging (notifications — not wired yet)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Mapbox (maps — not wired yet)
NEXT_PUBLIC_MAPBOX_TOKEN=
