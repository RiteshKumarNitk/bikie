<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13+ (API 33) requires this runtime-requested permission before any
         notification — including FCM push — can be shown (ADR-035). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Rider "Be findable" background location tracking (flutter_foreground_task) — a real
         Android foreground service, started only from an explicit foreground action (toggle ON,
         or restoring the saved preference on app launch/login), never from a background trigger.
         Deliberately does NOT request ACCESS_BACKGROUND_LOCATION: an already-running foreground
         service's own location work is exempt from that restriction, and nothing here starts
         the service without the app itself being in the foreground — see RiderFindabilityService.
         WAKE_LOCK keeps the device CPU awake while the service runs so the periodic location push
         isn't silently dropped by Doze. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="BIKIE"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FCM (ADR-035). Fallback channel/icon/color for a background/terminated push that
             somehow arrives without our own channelId override (push_channel.ts always sets
             one, but this is Android's own required fallback if that were ever missing) — all
             four real channels (`sos_channel`/`ride_channel`/`chat_channel`/`general_channel`)
             are created client-side at app startup (`push_channels.dart`) before this could
             matter in practice. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/launcher_icon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- flutter_foreground_task — do not rename, the plugin hardcodes this class name.
             foregroundServiceType="location" (not dataSync, which 6-hour-timeouts on Android 15
             and can't restart after boot) + FOREGROUND_SERVICE_LOCATION above are both required
             for Android 14+ to allow startForeground() to succeed at all. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:stopWithTask="true"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility so Razorpay Checkout can enumerate installed UPI
             apps (GPay / PhonePe / Paytm / …) for the UPI-intent payment option. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
    </queries>
</manifest>
