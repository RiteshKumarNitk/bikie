generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RENTER
  PARTNER
  ADMIN
}

/** ADR-053 — which experience/dashboard an account currently sees: Rider or Service Provider,
 * mutually exclusive, never both at once. Server-set only (identity-access's switchAccountType),
 * never client-writable. Superseded the old "dual capability" model (ADR-046b–051) where
 * `partnerStatus` non-null/non-SUSPENDED doubled as a routing signal — that conflation is exactly
 * what this field removes. `partnerStatus` below now means ONLY verification/trust status. */
enum AccountType {
  RIDER
  SERVICE_PROVIDER
}

/** ADR-046b/053 — Partner (Service Provider) verification/trust state. As of ADR-053 this is
 * purely a trust signal (has this profile been reviewed?), never a capability or routing signal —
 * `User.accountType` owns "which experience this account sees" now. "NOT_APPLIED" isn't a stored
 * value — it's represented by the absence of a `Partner` row entirely; every reader that needs all
 * 7 conceptual states surfaces that as `status: "NOT_APPLIED"` at the API layer. */
enum PartnerVerificationStatus {
  DRAFT
  PENDING_VERIFICATION
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum BikeCategory {
  ADVENTURE
  CRUISER
  ROYAL_ENFIELD
  SPORTS
  SCOOTER
  ELECTRIC
  TOURING
  LUXURY
  OFF_ROAD
}

enum PartnerType {
  RENTAL
  MECHANIC
  FUEL_DELIVERY
  TOUR_GUIDE
  HOTEL
  CAMPING
  ACCESSORIES
  PHOTOGRAPHY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripType {
  WEEKEND
  ADVENTURE
  ROAD_TRIP
  INTERNATIONAL
  GUIDED_TOUR
  EVENT
}

enum TripDifficulty {
  EASY
  MODERATE
  HARD
}

enum TripStatus {
  DRAFT
  PUBLISHED
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SOSAlertType {
  ACCIDENT
  BIKE_BREAKDOWN
  FUEL_EMPTY
  MEDICAL
  LOST
  OTHER
  LIFE_THREATENING
  FLAT_TYRE
  BATTERY_ISSUE
}

enum SOSStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

// --- Community Emergency Response System (ADR-033) ---

enum SOSSeverity {
  EMERGENCY
  ASSISTANCE
}

// NEARBY_RIDERS_COMMUNITY is reserved now (server-derived, not yet set by any code path) so
// the community/club-prioritization pass (a deliberately separate later phase) doesn't need
// its own schema migration — see ADR-033.
enum SOSEscalationTier {
  NEARBY_RIDERS_COMMUNITY
  NEARBY_RIDERS_GENERAL
  SERVICE_PROVIDERS
  ADMIN
}

enum SOSResponseStatus {
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  // ADR-045 — a responder (typically a partner) proactively declines before ever offering.
  // Distinct from WITHDRAWN (withdrawing an existing OFFERED offer) and REJECTED (the reporter
  // rejecting someone else's offer) — this is the responder's own "not interested" signal.
  DECLINED
}

enum SOSSessionStatus {
  ACTIVE
  HELPER_ARRIVED
  ASSISTANCE_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SOSTimelineEventType {
  SOS_CREATED
  RADIUS_EXPANDED
  ESCALATED_SERVICE_PROVIDERS
  ESCALATED_ADMIN
  HELPER_OFFERED
  HELPER_WITHDRAWN
  HELPER_ACCEPTED
  HELPER_REJECTED
  NAVIGATION_STARTED
  HELPER_ARRIVED
  ASSISTANCE_STARTED
  ASSISTANCE_COMPLETED
  SOS_RESOLVED
  SOS_CANCELLED
  RATING_SUBMITTED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PartnerMembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// --- Community Platform v2 (Milestone 8, ADR-011) ---

enum GroupType {
  COMMUNITY
  CLUB
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum GroupMemberStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum ConversationRole {
  ORGANIZER
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
}

enum AttachmentType {
  IMAGE
  DOCUMENT
}

enum ReportTargetType {
  MESSAGE
  USER
  TRIP
  CONVERSATION
  GROUP
}

enum ReportReason {
  SPAM
  ABUSE
  FAKE_ACCOUNT
  DANGEROUS_BEHAVIOUR
  HARASSMENT
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  WARN
  MUTE
  SUSPEND
  BAN
  UNBAN
  DELETE_MESSAGE
  CLOSE_RIDE_ROOM
  DELETE_RIDE_ROOM
}

/** ADR-053 — an account's `accountType` (RIDER/SERVICE_PROVIDER) is set once at registration and
 * changed only through this admin-reviewed support workflow, never self-service. */
enum AccountTypeChangeRequestStatus {
  PENDING
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
}

enum UserAccountStatus {
  ACTIVE
  WARNED
  MUTED
  SUSPENDED
  BANNED
}

enum NotificationType {
  RIDE_REQUEST_RECEIVED
  RIDE_REQUEST_APPROVED
  RIDE_REQUEST_REJECTED
  RIDE_ANNOUNCEMENT
  TRIP_CANCELLED
  TRIP_RESCHEDULED
  NEW_MESSAGE
  GROUP_JOIN_APPROVED
  MODERATION_ACTION
  SOS_ALERT
  SYSTEM
  // --- ADR-046b: Service Provider application/verification decisions ---
  PARTNER_APPLICATION_APPROVED
  PARTNER_APPLICATION_REJECTED
  PARTNER_APPLICATION_INFO_REQUESTED
  PARTNER_APPLICATION_SUSPENDED
  // --- ADR-053: Account Type Change Request decisions ---
  ACCOUNT_TYPE_CHANGE_APPROVED
  ACCOUNT_TYPE_CHANGE_REJECTED
  ACCOUNT_TYPE_CHANGE_INFO_REQUESTED
}

// --- Better Auth core models ---

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  /** Better Auth's `phone-number` plugin fields (ADR-013) — distinct from `phone` above,
   * which predates this and is still used for SOS profile completeness. Kept as two fields
   * rather than merged: `phoneNumber` is plugin-managed (unique, drives login/signup),
   * `phone` stays a plain profile field other features already read. Synced to match on
   * first phone verification (see packages/auth/src/server.ts). */
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean?  @default(false)
  role          UserRole  @default(RENTER)
  // ADR-053 — server-authoritative, mutually-exclusive UI selector: Rider or Service Provider.
  // The one thing every routing/nav call site reads now (replacing the old dual-capability
  // resolveActiveMode()-derived client cookie). Set only via identity-access's switchAccountType.
  accountType   AccountType @default(RIDER)
  // ADR-046b — denormalized copy of `Partner.verificationStatus`, kept in sync on every write to
  // the `Partner` row (same pattern as `phone` mirroring the phone-number plugin's field). Exists
  // so a Better Auth session can expose `session.user.partnerStatus` cheaply (registered in
  // `packages/auth/src/server.ts`'s `additionalFields`, same mechanism as `role`/`accountStatus`)
  // without every route needing a second query. `Partner` itself remains the source of truth.
  // ADR-053: means ONLY verification/trust status now — never read for capability/routing, see
  // `accountType` above for that.
  partnerStatus PartnerVerificationStatus?
  accountStatus          UserAccountStatus @default(ACTIVE)
  accountStatusExpiresAt DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  bikes         Bike[]        @relation("BikeOwner")
  partner       Partner?
  bookings      Booking[]
  reviews       Review[]
  wishlist      Wishlist[]
  tripsOrganized Trip[]       @relation("TripOrganizer")
  tripsJoined   TripParticipant[]
  conversations ConversationParticipant[]
  messagesSent  Message[]
  membership    UserMembership[]
  partnerMembership PartnerMembership[]
  membershipInvoices MembershipInvoice[]
  sosAlerts     SOSAlert[]
  sosResponses  SOSAlertResponse[]
  providerReviewsWritten ProviderReview[] @relation("ProviderReviewRider")
  assignedSosAlerts SOSAlert[]         @relation("SOSAssignedHelper")
  sosHelperSessions SOSSession[]       @relation("SOSSessionHelper")
  sosRiderSessions  SOSSession[]       @relation("SOSSessionRider")
  sosTimelineEvents SOSTimelineEvent[]
  // --- Minimal SOS-helper reputation (ADR-033 Phase D — counters + rating only, no badges/
  // trust-tier, deliberately deferred per client's explicit call). Never client-writable —
  // derived only from SOSSession completion/rating, see reputation.application.ts. ---
  emergencyResponseCount Int     @default(0)
  helperRatingAvg        Decimal @default(0) @db.Decimal(2, 1)
  helperRatingCount      Int     @default(0)
  referralCode  String?   @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]    @relation("Referrals")
  groupsOwned         Group[]            @relation("GroupOwner")
  groupMemberships    GroupMember[]
  announcements       Announcement[]
  reportsFiled        Report[]           @relation("ReportsFiled")
  reportsReviewed     Report[]           @relation("ReportsReviewed")
  moderationReceived  ModerationAction[] @relation("ModerationTarget")
  moderationIssued    ModerationAction[] @relation("ModerationActor")
  notifications       Notification[]
  messageReceipts     MessageReceipt[]
  messageReactions    MessageReaction[]
  riderProfile        RiderProfile?
  riderLocation       RiderLocation?
  pushSubscriptions   PushSubscription[]
  accountTypeChangeRequests         AccountTypeChangeRequest[] @relation("AccountTypeChangeRequests")
  accountTypeChangeRequestsReviewed AccountTypeChangeRequest[] @relation("AccountTypeChangeRequestsReviewed")

  @@map("user")
}

// --- Rider profile (post-signup onboarding, skippable — see .docs/DECISIONS.md ADR-012/ADR-014) ---

enum GovernmentIdType {
  AADHAAR
  PASSPORT
}

enum RiderFrequency {
  OCCASIONAL
  WEEKLY
  DAILY
}

enum RidingClubType {
  SOLO
  CLUB_MEMBER
}

model RiderProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  drivingLicenceNumber  String?
  drivingLicenceExpiry  DateTime?
  addressLine           String?
  area                  String?
  district              String?
  pincode               String?
  country               String?            @default("India")
  // --- Added in ADR-014 (client-provided onboarding field list) ---
  fatherName            String?
  motherName            String?
  dateOfBirth           DateTime?
  gender                String?
  bloodGroup            String?
  medicalHistory        String?
  allergies             String?
  vehicleType           String?
  vehicleBrand          String?
  vehicleModel          String?
  // ADR-059 — surfaced (unredacted, like the three fields above) on SOS alert dispatch to
  // nearby riders/service providers via the DLT "BIKIE_SR" SMS template.
  vehicleRegistrationNumber String?
  governmentIdType      GovernmentIdType?
  governmentIdNumber    String?
  riderFrequency        RiderFrequency?
  ridingClubType        RidingClubType?    @default(SOLO)
  clubName              String?
  /** True once the user has been through the onboarding gate — either filled it in or
   * explicitly skipped — so we don't show the gate again on their next login. */
  onboardingSkipped     Boolean            @default(false)
  emergencyContacts     RiderEmergencyContact[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@map("rider_profile")
}

model RiderEmergencyContact {
  id             String       @id @default(cuid())
  riderProfileId String
  riderProfile   RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  /** Optional — SOS fan-out emails contacts who have one, on top of SMS/WhatsApp to `phone`. */
  email          String?
  relation       String?
  createdAt      DateTime     @default(now())

  @@index([riderProfileId])
  @@map("rider_emergency_contact")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Content models ---

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      BikeCategory @unique
  iconUrl   String?
  imageUrl  String
  sortOrder Int          @default(0)
  bikes     Bike[]
  createdAt DateTime     @default(now())
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  state       String
  imageUrl    String
  description String?
  isPopular   Boolean  @default(false)
  bikeCount   Int      @default(0)
  bikes       Bike[]
  trips       Trip[]
  createdAt   DateTime @default(now())
}

model Bike {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  brand             String
  categoryId        String
  category          Category     @relation(fields: [categoryId], references: [id])
  destinationId     String?
  destination       Destination? @relation(fields: [destinationId], references: [id])
  ownerId           String?
  owner             User?        @relation("BikeOwner", fields: [ownerId], references: [id])
  pricePerDay       Decimal      @db.Decimal(10, 2)
  securityDeposit   Decimal      @default(2000) @db.Decimal(10, 2)
  city              String
  imageUrl          String
  gallery           String[]     @default([])
  ratingAvg         Decimal      @default(0) @db.Decimal(2, 1)
  ratingCount       Int          @default(0)
  isFeatured        Boolean      @default(false)
  description       String?
  engineCc          Int?
  mileageKmpl       Int?
  fuelTankLitres    Int?
  hasAbs            Boolean      @default(false)
  seatHeightMm      Int?
  luggageCapacityL  Int?
  instantBooking    Boolean      @default(true)
  helmetIncluded    Boolean      @default(true)
  deliveryAvailable Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bookings          Booking[]
  reviews           Review[]
  wishlistedBy      Wishlist[]

  @@index([isFeatured])
  @@index([city])
  @@index([ownerId])
}

model Testimonial {
  id              String   @id @default(cuid())
  authorName      String
  authorAvatarUrl String?
  authorLocation  String?
  rating          Int
  quote           String
  isFeatured      Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// --- Partner profile ---

model Partner {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  type         PartnerType
  city         String
  description  String?
  logoUrl      String?
  // ADR-046b — kept true iff `verificationStatus === APPROVED`, written in the same
  // transaction as every status change. Left in place (rather than replaced outright) so every
  // pre-existing verified/available/type-matched SOS-eligibility query that already reads this
  // boolean needs zero changes; `verificationStatus` is the new source of truth.
  isVerified   Boolean     @default(false)
  // §25 of the master product spec — Rider → Service Provider service reviews, aggregated into
  // `ratingAvg`/`ratingCount` (surfaced on discovery cards and the partner dashboard).
  reviews      ProviderReview[]
  verificationStatus PartnerVerificationStatus @default(DRAFT)
  rejectionReason    String?
  // Holds the current reject/more-info/suspend note shown back to the applicant. The full
  // decision history (who, when, which action) lives in `AuditLog` (entity: "Partner"), not a
  // second table here.
  reviewNote         String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  profilePhotoUrl    String?
  shopPhotoUrls      String[] @default([])
  identityDocumentUrl String?
  businessDocumentUrl String?
  ratingAvg    Decimal     @default(0) @db.Decimal(2, 1)
  ratingCount  Int         @default(0)
  // --- Added in ADR-014 (client-provided onboarding field list) ---
  contactPerson1Name   String?
  contactPerson1Mobile String?
  contactPerson2Name   String?
  contactPerson2Mobile String?
  businessMobile       String?
  businessEmail        String?
  // --- Added in ADR-036 (shop location + typed government ID, superseding aadhaarNumber) ---
  addressLine       String?
  area              String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  governmentIdType  GovernmentIdType?
  governmentIdNumber String?
  // --- §6 of the master product spec (OPERATIONS) ---
  // Working hours as free text (e.g. "Mon–Sat 9:00–19:00") — deliberately not a structured
  // Json schedule, most providers here run simple fixed hours and a text field is honest about
  // that without inventing a slot model nobody has validated yet.
  workingHours       String?
  serviceRadiusKm    Int?
  yearsOfExperience  Int?
  // --- Added in ADR-044 (SOS emergency-assistance dashboard) ---
  // Defaults false, not true: existing partners shouldn't start receiving live emergency pings
  // the moment this migration runs, before they've even seen the toggle to control it.
  isAvailable        Boolean @default(false)
  // Explicit opt-in to be dispatched for SOS categories outside this partner's own `type` (e.g.
  // a FUEL_DELIVERY partner receiving a MEDICAL emergency) — see partner-mapping.ts.
  isGeneralResponder Boolean @default(false)
  createdAt    DateTime    @default(now())

  @@index([city])
  @@index([latitude, longitude])
  @@index([isAvailable])
  @@index([verificationStatus])
}

// --- Bookings & reviews ---

model Booking {
  id           String        @id @default(cuid())
  bikeId       String
  bike         Bike          @relation(fields: [bikeId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  startDate    DateTime
  endDate      DateTime
  totalPrice   Decimal       @db.Decimal(10, 2)
  status       BookingStatus @default(PENDING)
  pickupCity   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  review       Review?

  @@index([userId])
  @@index([bikeId])
  @@index([bikeId, startDate, endDate])
}

model Review {
  id        String   @id @default(cuid())
  bikeId    String
  bike      Bike     @relation(fields: [bikeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([bikeId])
  @@index([userId])
}

// --- Trips ---

model Trip {
  id            String            @id @default(cuid())
  slug          String            @unique
  title         String
  description   String
  imageUrl      String
  gallery       String[]          @default([])
  type          TripType
  difficulty    TripDifficulty    @default(MODERATE)
  price         Decimal           @db.Decimal(10, 2)
  seatsTotal    Int
  seatsLeft     Int
  meetingPoint  String?
  meetingLat    Float?
  meetingLng    Float?
  emergencyContacts Json?
  startDate     DateTime
  endDate       DateTime
  status        TripStatus        @default(UPCOMING)
  organizerId   String
  organizer     User              @relation("TripOrganizer", fields: [organizerId], references: [id])
  // ADR-037: the organizer types a destination name freely instead of picking from the curated
  // `Destination` catalog below — `destinationId` stays for the (now unused-at-creation) curated
  // link, `destinationName` is what's actually shown. See ADR-037 in .docs/DECISIONS.md.
  destinationName String?
  destinationId String?
  destination   Destination?      @relation(fields: [destinationId], references: [id])
  participants  TripParticipant[]
  conversation  Conversation?
  announcements Announcement[]
  createdAt     DateTime          @default(now())

  @@index([status])
  @@index([organizerId])
}

model TripParticipant {
  id        String            @id @default(cuid())
  tripId    String
  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  status    ParticipantStatus @default(PENDING)
  message   String?
  joinedAt  DateTime          @default(now())
  decidedAt DateTime?

  @@unique([tripId, userId])
  @@index([userId])
}

// --- Wishlist ---

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bikeId    String
  bike      Bike     @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bikeId])
}

// --- Messaging ---

model Conversation {
  id           String                     @id @default(cuid())
  subject      String?
  tripId       String?                    @unique
  trip         Trip?                      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  isLocked     Boolean                    @default(false)
  lockedAt     DateTime?
  lockedById   String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
  group        Group?
  sosSession   SOSSession?

  @@map("conversation")
}

model ConversationParticipant {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationRole  @default(MEMBER)
  joinedAt       DateTime          @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participant")
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String?
  sender            User?        @relation(fields: [senderId], references: [id])
  type              MessageType  @default(TEXT)
  content           String?
  metadata          Json?
  ciphertext        String?
  iv                String?
  authTag           String?
  encryptionVersion Int?
  replyToId         String?
  replyTo           Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           Message[]    @relation("MessageReplies")
  editedAt          DateTime?
  deletedAt         DateTime?
  deletedBy         String?
  attachments       MessageAttachment[]
  receipts          MessageReceipt[]
  reactions         MessageReaction[]
  createdAt         DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@map("message")
}

model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime?
  readAt      DateTime?

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_receipt")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reaction")
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      AttachmentType
  url       String
  publicId  String
  fileName  String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  createdAt DateTime       @default(now())

  @@index([messageId])
  @@map("message_attachment")
}

model Announcement {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  pinnedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([tripId])
  @@map("announcement")
}

model Group {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description    String
  imageUrl       String
  type           GroupType     @default(COMMUNITY)
  city           String?
  isPrivate      Boolean       @default(false)
  ownerId        String
  owner          User          @relation("GroupOwner", fields: [ownerId], references: [id])
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  members        GroupMember[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([type])
  @@map("group_entity")
}

model GroupMember {
  id       String            @id @default(cuid())
  groupId  String
  group    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole   @default(MEMBER)
  status   GroupMemberStatus @default(APPROVED)
  joinedAt DateTime          @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_member")
}

model Report {
  id                String             @id @default(cuid())
  reporterId        String
  reporter          User               @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType        ReportTargetType
  targetId          String
  reason            ReportReason
  details           String?
  status            ReportStatus       @default(PENDING)
  reviewedById      String?
  reviewedBy        User?              @relation("ReportsReviewed", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  resolutionNote    String?
  moderationActions ModerationAction[]
  createdAt         DateTime           @default(now())

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("report")
}

model ModerationAction {
  id              String               @id @default(cuid())
  targetUserId    String?
  targetUser      User?                @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  adminId         String
  admin           User                 @relation("ModerationActor", fields: [adminId], references: [id])
  type            ModerationActionType
  reason          String
  reportId        String?
  report          Report?              @relation(fields: [reportId], references: [id])
  relatedEntity   String?
  relatedEntityId String?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())

  @@index([targetUserId])
  @@index([reportId])
  @@map("moderation_action")
}

/** ADR-053 — "I picked the wrong account type at signup" support ticket. `accountType` is never
 * self-service; this is the only path (besides initial registration) that changes it, and only
 * once an admin approves. `currentType`/`requestedType` are snapshotted at submission time so the
 * request stays meaningful even if the user's live accountType changes via a different, later
 * request before this one is reviewed. */
model AccountTypeChangeRequest {
  id             String                         @id @default(cuid())
  userId         String
  user           User                           @relation("AccountTypeChangeRequests", fields: [userId], references: [id], onDelete: Cascade)
  currentType    AccountType
  requestedType  AccountType
  reason         String
  supportingInfo String?
  status         AccountTypeChangeRequestStatus @default(PENDING)
  adminRemarks   String?
  reviewedById   String?
  reviewedBy     User?                          @relation("AccountTypeChangeRequestsReviewed", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@index([userId])
  @@index([status])
  @@map("account_type_change_request")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  entity    String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notification")
}

// --- Membership ---

model MembershipPlan {
  id            String   @id @default(cuid())
  name          String
  description   String
  price         Decimal  @db.Decimal(10, 2)
  durationDays  Int
  benefits      String[]
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  memberships   UserMembership[]

  @@map("membership_plan")
}

model UserMembership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      MembershipPlan   @relation(fields: [planId], references: [id])
  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)
  // ADR-069: `@unique` (nullable — Postgres permits many NULLs, so free/legacy rows are
  // unaffected) makes a replayed `/purchase` callback for the same payment idempotent at the
  // DB level rather than minting a second membership.
  paymentId String? @unique
  // ADR-043: Razorpay's own order id, kept alongside paymentId for support/reconciliation once
  // a purchase is a real, signature-verified payment rather than a client-supplied dummy string.
  // ADR-069: also `@unique` — one Razorpay order can activate at most one membership.
  razorpayOrderId String? @unique
  createdAt DateTime         @default(now())
  // ADR-070 — the immutable billing receipt for this activation (at most one).
  invoice   MembershipInvoice?

  @@index([userId])
  @@index([status])
  @@map("user_membership")
}

// --- Partner (Service Provider) Membership ---
// ADR-051: a Partner's own membership, entirely separate from the Rider `MembershipPlan`/
// `UserMembership` above — different audience, different plans, admin-managed. Mirrors the
// Rider membership shape deliberately (same field set, same dynamic/DB-backed plan model) so
// the two systems stay easy to reason about side by side, but shares zero types/tables with it.

model PartnerMembershipPlan {
  id           String                  @id @default(cuid())
  name         String
  description  String
  price        Decimal                 @db.Decimal(10, 2) // 0 = free tier
  durationDays Int                     @default(365) // admin-configurable; defaults to 1 year
  benefits     String[]
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  memberships  PartnerMembership[]

  @@map("partner_membership_plan")
}

model PartnerMembership {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      PartnerMembershipPlan    @relation(fields: [planId], references: [id])
  startDate DateTime
  endDate   DateTime
  status    PartnerMembershipStatus  @default(ACTIVE)
  // ADR-069 — payment idempotency, mirrors `UserMembership` (nullable unique: free-tier and
  // grandfathered `legacy-free-partner-plan` rows carry NULL here and are unaffected).
  paymentId String? @unique
  razorpayOrderId String? @unique
  createdAt DateTime                 @default(now())
  // ADR-070 — the immutable billing receipt for this activation (at most one).
  invoice   MembershipInvoice?

  @@index([userId])
  @@index([status])
  @@map("partner_membership")
}

// --- Membership billing (ADR-070) ---
// One immutable receipt per membership activation, for both account types. Every commercially
// meaningful value (amount, currency, plan name, duration, membership window, payer identity) is
// SNAPSHOT here at purchase time and never re-derived — an admin later changing a plan's price or
// duration must not alter any historic invoice or membership. Exactly one of
// `userMembershipId` / `partnerMembershipId` is set. `razorpayPaymentId` (real mode) and
// `paymentId` (mirrors the membership row: the Razorpay payment id in real mode, a `DUMMY-…`
// string in dev-fallback mode) are both `@unique`, so invoice creation is idempotent under a
// replayed `/purchase` exactly like membership creation is (ADR-069).

enum InvoiceStatus {
  PAID
  REFUNDED
}

model MembershipInvoice {
  id          String      @id @default(cuid())
  receiptNo   String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType AccountType

  userMembershipId    String?            @unique
  userMembership      UserMembership?    @relation(fields: [userMembershipId], references: [id], onDelete: SetNull)
  partnerMembershipId String?            @unique
  partnerMembership   PartnerMembership? @relation(fields: [partnerMembershipId], references: [id], onDelete: SetNull)

  // Snapshot at purchase time — never re-read from the plan.
  planId              String
  planName            String
  amount              Decimal  @db.Decimal(10, 2)
  currency            String   @default("INR")
  durationDays        Int
  membershipStartDate DateTime
  membershipEndDate   DateTime

  // Payer identity snapshot.
  customerName  String
  customerPhone String?

  status            InvoiceStatus @default(PAID)
  paymentId         String?  @unique
  razorpayPaymentId String?  @unique
  razorpayOrderId   String?
  paidAt            DateTime

  // Stamped once the DLT confirmation SMS is accepted by MSG91 — the persisted "sent exactly
  // once" marker (ADR-058/070). NULL = not yet sent / send failed → safe to retry.
  confirmationSmsSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("membership_invoice")
}

// --- SOS / Emergency ---

// --- §25: Rider → Service Provider service reviews ---

// Created when a rider rates a COMPLETED SOS assistance session whose helper has a Partner
// profile. Deliberately separate from `Review` (bike reviews) and from `SOSSession.rating`
// (the private per-session rating) — this is the public, listed service review of a provider's
// business, and the aggregate that powers the "⭐ 4.8 (126)" on discovery cards (§12). One
// review per SOS session — a rider rates a session once, so `sessionId` is unique.
model ProviderReview {
  id         String   @id @default(cuid())
  providerId String
  provider   Partner  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  riderId    String
  rider      User     @relation("ProviderReviewRider", fields: [riderId], references: [id])
  sessionId  String   @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([riderId])
  @@map("provider_review")
}

model SOSAlert {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        SOSAlertType
  description String?
  latitude    Float
  longitude   Float
  city        String
  status      SOSStatus   @default(ACTIVE)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime    @default(now())
  responses   SOSAlertResponse[]

  // --- Community Emergency Response System (ADR-033) ---
  // `severity` is always server-derived from `type` — never trust a client-supplied value,
  // it would let a reporter jump straight to the ADMIN tier by mislabeling an assistance case.
  severity           SOSSeverity        @default(ASSISTANCE)
  // The guarded column the transactional accept hangs on (see sos-session.repository.ts) —
  // `WHERE assignedHelperId IS NULL` inside the accept transaction is what prevents two
  // helpers from both being told they're "the one."
  assignedHelperId   String?
  assignedHelper     User?              @relation("SOSAssignedHelper", fields: [assignedHelperId], references: [id])
  escalationTier     SOSEscalationTier  @default(NEARBY_RIDERS_GENERAL)
  currentRadiusMeters Int               @default(5000)
  // Cron-poll key for the escalation ticker (GET /api/cron/sos-escalate) — null once
  // assigned or resolved, so the ticker's query naturally stops picking the alert up.
  nextEscalationAt  DateTime?
  sessions          SOSSession[]
  timelineEvents    SOSTimelineEvent[]

  // --- Reverse-geocoded address (ADR-038) — best-effort, nullable. Resolved once at creation
  // time from `latitude`/`longitude` via Nominatim; a lookup failure/timeout leaves these null
  // and every caller falls back to `city`/raw coordinates, same as before this existed.
  placeName         String?
  area              String?
  formattedAddress  String?

  @@index([city, status])
  @@index([status])
  @@index([status, nextEscalationAt])
  @@index([assignedHelperId])
  @@map("sos_alert")
}

model SOSAlertResponse {
  id          String            @id @default(cuid())
  alertId     String
  alert       SOSAlert          @relation(fields: [alertId], references: [id], onDelete: Cascade)
  responderId String
  responder   User              @relation(fields: [responderId], references: [id])
  message     String?
  status      SOSResponseStatus @default(OFFERED)
  distanceMeters Float?
  etaMinutes     Int?
  respondedAt    DateTime?
  respondedBy    String?
  createdAt   DateTime          @default(now())
  session     SOSSession?

  @@unique([alertId, responderId])
  @@map("sos_alert_response")
}

// SOS Session — deliberately NOT a Trip. Created only once a rider accepts a specific
// helper's offer; owns the live chat/timeline/status for that one incident. Not unique on
// alertId: if a helper cancels, the alert re-opens and a second session can form later for
// the same alert. "Only one truly active assignment" is enforced by SOSAlert.assignedHelperId
// (see the transactional accept), not by a DB constraint on this table.
model SOSSession {
  id                  String           @id @default(cuid())
  alertId             String
  alert               SOSAlert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  helperId            String
  helper              User             @relation("SOSSessionHelper", fields: [helperId], references: [id])
  riderId             String
  rider               User             @relation("SOSSessionRider", fields: [riderId], references: [id])
  offerId             String           @unique
  offer               SOSAlertResponse @relation(fields: [offerId], references: [id])
  status              SOSSessionStatus @default(ACTIVE)
  conversationId      String?          @unique
  conversation        Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  startedAt           DateTime         @default(now())
  helperArrivedAt     DateTime?
  assistanceStartedAt DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  // Minimal Phase-D reputation hook (ADR-033): the raw rating lives here since it belongs to
  // exactly one session; nothing aggregates it into User.helperRatingAvg until Phase D.
  rating              Int?
  ratingComment       String?
  timelineEvents      SOSTimelineEvent[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([alertId])
  @@index([helperId])
  @@index([riderId])
  @@map("sos_session")
}

// Full audit trail for the SOS lifecycle, deliberately separate from the moderation-only
// AuditLog model — different lifecycle, different consumers (the rider-facing timeline UI).
model SOSTimelineEvent {
  id        String                @id @default(cuid())
  alertId   String
  alert     SOSAlert              @relation(fields: [alertId], references: [id], onDelete: Cascade)
  sessionId String?
  session   SOSSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type      SOSTimelineEventType
  actorId   String?
  actor     User?                 @relation(fields: [actorId], references: [id])
  metadata  Json?
  createdAt DateTime              @default(now())

  @@index([alertId, createdAt])
  @@index([sessionId])
  @@map("sos_timeline_event")
}

// --- Audit Log ---

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// --- Nearby riders (ADR-016) — un-defers ADR-011's "Live Location" extension point ---

// `location` is only ever read/written via $queryRaw/$executeRaw in
// rider-location.repository.ts — Unsupported types are invisible to the generated Client's
// normal CRUD methods. The PostGIS extension and this model's GiST index are BOTH hand-written
// into this model's migration.sql and are invisible to `prisma migrate dev`'s diff engine —
// see that migration's comments before touching this table's migrations again.
model RiderLocation {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location         Unsupported("geography(Point, 4326)")?
  sharingEnabled   Boolean   @default(false)
  // ADR-045 — independent of sharingEnabled: a rider can keep sharing (findable/browsable) while
  // opting out of being paged as an SOS dispatch candidate, or vice versa. Defaults true (unlike
  // Partner.isAvailable's false default) because every existing rider already receives SOS pings
  // today — defaulting false would silently cut off dispatch for the whole existing user base.
  receiveSosAlerts Boolean   @default(true)
  updatedAt        DateTime  @updatedAt

  @@map("rider_location")
}

// --- Push notifications (ADR-016 web, ADR-035 Android) — Firebase Cloud Messaging ---

enum PushPlatform {
  WEB
  ANDROID
  IOS
}

model PushSubscription {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token               String       @unique
  platform            PushPlatform @default(WEB)
  // Native-device fields — null for WEB rows (a browser has no stable device id and no
  // installed "app version"). One row per physical device per user, keyed by `token` (a
  // user can hold many rows — multi-device support falls out of that for free, no separate
  // "device" concept needed).
  deviceId            String?
  deviceName          String?
  appVersion          String?
  notificationsEnabled Boolean     @default(true)
  createdAt           DateTime     @default(now())
  lastSeenAt          DateTime     @updatedAt

  @@index([userId])
  @@map("push_subscription")
}
