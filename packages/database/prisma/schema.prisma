generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RENTER
  PARTNER
  ADMIN
}

enum BikeCategory {
  ADVENTURE
  CRUISER
  ROYAL_ENFIELD
  SPORTS
  SCOOTER
  ELECTRIC
  TOURING
  LUXURY
  OFF_ROAD
}

enum PartnerType {
  RENTAL
  MECHANIC
  FUEL_DELIVERY
  TOUR_GUIDE
  HOTEL
  CAMPING
  ACCESSORIES
  PHOTOGRAPHY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripType {
  WEEKEND
  ADVENTURE
  ROAD_TRIP
  INTERNATIONAL
  GUIDED_TOUR
  EVENT
}

enum TripDifficulty {
  EASY
  MODERATE
  HARD
}

enum TripStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SOSAlertType {
  ACCIDENT
  BIKE_BREAKDOWN
  FUEL_EMPTY
  MEDICAL
  LOST
  OTHER
}

enum SOSStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// --- Community Platform v2 (Milestone 8, ADR-011) ---

enum GroupType {
  COMMUNITY
  CLUB
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum GroupMemberStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum ConversationRole {
  ORGANIZER
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
}

enum AttachmentType {
  IMAGE
  DOCUMENT
}

enum ReportTargetType {
  MESSAGE
  USER
  TRIP
  CONVERSATION
  GROUP
}

enum ReportReason {
  SPAM
  ABUSE
  FAKE_ACCOUNT
  DANGEROUS_BEHAVIOUR
  HARASSMENT
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  WARN
  MUTE
  SUSPEND
  BAN
  UNBAN
  DELETE_MESSAGE
  CLOSE_RIDE_ROOM
  DELETE_RIDE_ROOM
}

enum UserAccountStatus {
  ACTIVE
  WARNED
  MUTED
  SUSPENDED
  BANNED
}

enum NotificationType {
  RIDE_REQUEST_RECEIVED
  RIDE_REQUEST_APPROVED
  RIDE_REQUEST_REJECTED
  RIDE_ANNOUNCEMENT
  NEW_MESSAGE
  GROUP_JOIN_APPROVED
  MODERATION_ACTION
  SOS_ALERT
  SYSTEM
}

// --- Better Auth core models ---

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  role          UserRole  @default(RENTER)
  accountStatus          UserAccountStatus @default(ACTIVE)
  accountStatusExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  bikes         Bike[]        @relation("BikeOwner")
  partner       Partner?
  bookings      Booking[]
  reviews       Review[]
  wishlist      Wishlist[]
  tripsOrganized Trip[]       @relation("TripOrganizer")
  tripsJoined   TripParticipant[]
  conversations ConversationParticipant[]
  messagesSent  Message[]
  membership    UserMembership[]
  sosAlerts     SOSAlert[]
  sosResponses  SOSAlertResponse[]
  referralCode  String?   @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]    @relation("Referrals")
  groupsOwned         Group[]            @relation("GroupOwner")
  groupMemberships    GroupMember[]
  announcements       Announcement[]
  reportsFiled        Report[]           @relation("ReportsFiled")
  reportsReviewed     Report[]           @relation("ReportsReviewed")
  moderationReceived  ModerationAction[] @relation("ModerationTarget")
  moderationIssued    ModerationAction[] @relation("ModerationActor")
  notifications       Notification[]
  messageReceipts     MessageReceipt[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- Content models ---

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      BikeCategory @unique
  iconUrl   String?
  imageUrl  String
  sortOrder Int          @default(0)
  bikes     Bike[]
  createdAt DateTime     @default(now())
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  state       String
  imageUrl    String
  description String?
  isPopular   Boolean  @default(false)
  bikeCount   Int      @default(0)
  bikes       Bike[]
  trips       Trip[]
  createdAt   DateTime @default(now())
}

model Bike {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  brand             String
  categoryId        String
  category          Category     @relation(fields: [categoryId], references: [id])
  destinationId     String?
  destination       Destination? @relation(fields: [destinationId], references: [id])
  ownerId           String?
  owner             User?        @relation("BikeOwner", fields: [ownerId], references: [id])
  pricePerDay       Decimal      @db.Decimal(10, 2)
  securityDeposit   Decimal      @default(2000) @db.Decimal(10, 2)
  city              String
  imageUrl          String
  gallery           String[]     @default([])
  ratingAvg         Decimal      @default(0) @db.Decimal(2, 1)
  ratingCount       Int          @default(0)
  isFeatured        Boolean      @default(false)
  description       String?
  engineCc          Int?
  mileageKmpl       Int?
  fuelTankLitres    Int?
  hasAbs            Boolean      @default(false)
  seatHeightMm      Int?
  luggageCapacityL  Int?
  instantBooking    Boolean      @default(true)
  helmetIncluded    Boolean      @default(true)
  deliveryAvailable Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bookings          Booking[]
  reviews           Review[]
  wishlistedBy      Wishlist[]

  @@index([isFeatured])
}

model Testimonial {
  id              String   @id @default(cuid())
  authorName      String
  authorAvatarUrl String?
  authorLocation  String?
  rating          Int
  quote           String
  isFeatured      Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// --- Partner profile ---

model Partner {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  type         PartnerType
  city         String
  description  String?
  logoUrl      String?
  isVerified   Boolean     @default(false)
  ratingAvg    Decimal     @default(0) @db.Decimal(2, 1)
  ratingCount  Int         @default(0)
  createdAt    DateTime    @default(now())
}

// --- Bookings & reviews ---

model Booking {
  id           String        @id @default(cuid())
  bikeId       String
  bike         Bike          @relation(fields: [bikeId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  startDate    DateTime
  endDate      DateTime
  totalPrice   Decimal       @db.Decimal(10, 2)
  status       BookingStatus @default(PENDING)
  pickupCity   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  review       Review?

  @@index([userId])
  @@index([bikeId])
}

model Review {
  id        String   @id @default(cuid())
  bikeId    String
  bike      Bike     @relation(fields: [bikeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([bikeId])
}

// --- Trips ---

model Trip {
  id            String            @id @default(cuid())
  slug          String            @unique
  title         String
  description   String
  imageUrl      String
  gallery       String[]          @default([])
  type          TripType
  difficulty    TripDifficulty    @default(MODERATE)
  price         Decimal           @db.Decimal(10, 2)
  seatsTotal    Int
  seatsLeft     Int
  meetingPoint  String?
  meetingLat    Float?
  meetingLng    Float?
  emergencyContacts Json?
  startDate     DateTime
  endDate       DateTime
  status        TripStatus        @default(UPCOMING)
  organizerId   String
  organizer     User              @relation("TripOrganizer", fields: [organizerId], references: [id])
  destinationId String?
  destination   Destination?      @relation(fields: [destinationId], references: [id])
  participants  TripParticipant[]
  conversation  Conversation?
  announcements Announcement[]
  createdAt     DateTime          @default(now())

  @@index([status])
}

model TripParticipant {
  id        String            @id @default(cuid())
  tripId    String
  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  status    ParticipantStatus @default(PENDING)
  message   String?
  joinedAt  DateTime          @default(now())
  decidedAt DateTime?

  @@unique([tripId, userId])
}

// --- Wishlist ---

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bikeId    String
  bike      Bike     @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bikeId])
}

// --- Messaging ---

model Conversation {
  id           String                     @id @default(cuid())
  subject      String?
  tripId       String?                    @unique
  trip         Trip?                      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  isLocked     Boolean                    @default(false)
  lockedAt     DateTime?
  lockedById   String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
  group        Group?

  @@map("conversation")
}

model ConversationParticipant {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationRole  @default(MEMBER)
  joinedAt       DateTime          @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_participant")
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String?
  sender            User?        @relation(fields: [senderId], references: [id])
  type              MessageType  @default(TEXT)
  content           String?
  ciphertext        String?
  iv                String?
  authTag           String?
  encryptionVersion Int?
  replyToId         String?
  replyTo           Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           Message[]    @relation("MessageReplies")
  editedAt          DateTime?
  deletedAt         DateTime?
  deletedBy         String?
  attachments       MessageAttachment[]
  receipts          MessageReceipt[]
  createdAt         DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@map("message")
}

model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime?
  readAt      DateTime?

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_receipt")
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      AttachmentType
  url       String
  publicId  String
  fileName  String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  createdAt DateTime       @default(now())

  @@index([messageId])
  @@map("message_attachment")
}

model Announcement {
  id        String    @id @default(cuid())
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  pinnedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([tripId])
  @@map("announcement")
}

model Group {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description    String
  imageUrl       String
  type           GroupType     @default(COMMUNITY)
  city           String?
  isPrivate      Boolean       @default(false)
  ownerId        String
  owner          User          @relation("GroupOwner", fields: [ownerId], references: [id])
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  members        GroupMember[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([type])
  @@map("group_entity")
}

model GroupMember {
  id       String            @id @default(cuid())
  groupId  String
  group    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole   @default(MEMBER)
  status   GroupMemberStatus @default(APPROVED)
  joinedAt DateTime          @default(now())

  @@unique([groupId, userId])
  @@map("group_member")
}

model Report {
  id                String             @id @default(cuid())
  reporterId        String
  reporter          User               @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType        ReportTargetType
  targetId          String
  reason            ReportReason
  details           String?
  status            ReportStatus       @default(PENDING)
  reviewedById      String?
  reviewedBy        User?              @relation("ReportsReviewed", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  resolutionNote    String?
  moderationActions ModerationAction[]
  createdAt         DateTime           @default(now())

  @@index([status])
  @@index([targetType, targetId])
  @@map("report")
}

model ModerationAction {
  id              String               @id @default(cuid())
  targetUserId    String?
  targetUser      User?                @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  adminId         String
  admin           User                 @relation("ModerationActor", fields: [adminId], references: [id])
  type            ModerationActionType
  reason          String
  reportId        String?
  report          Report?              @relation(fields: [reportId], references: [id])
  relatedEntity   String?
  relatedEntityId String?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())

  @@index([targetUserId])
  @@index([reportId])
  @@map("moderation_action")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  entity    String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notification")
}

// --- Membership ---

model MembershipPlan {
  id            String   @id @default(cuid())
  name          String
  description   String
  price         Decimal  @db.Decimal(10, 2)
  durationDays  Int
  benefits      String[]
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  memberships   UserMembership[]

  @@map("membership_plan")
}

model UserMembership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      MembershipPlan   @relation(fields: [planId], references: [id])
  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)
  paymentId String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([status])
  @@map("user_membership")
}

// --- SOS / Emergency ---

model SOSAlert {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        SOSAlertType
  description String?
  latitude    Float
  longitude   Float
  city        String
  status      SOSStatus   @default(ACTIVE)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime    @default(now())
  responses   SOSAlertResponse[]

  @@index([city, status])
  @@index([status])
  @@map("sos_alert")
}

model SOSAlertResponse {
  id          String   @id @default(cuid())
  alertId     String
  alert       SOSAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  responderId String
  responder   User     @relation(fields: [responderId], references: [id])
  message     String?
  status      String   @default("RESPONDING")
  createdAt   DateTime @default(now())

  @@unique([alertId, responderId])
  @@map("sos_alert_response")
}

// --- Audit Log ---

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
