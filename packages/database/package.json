{
  "name": "@bikie/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "dotenv -e ../../apps/web/.env.local -- prisma generate",
    "db:migrate": "dotenv -e ../../apps/web/.env.local -- prisma migrate dev",
    "db:seed": "dotenv -e ../../apps/web/.env.local -- tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@bikie/types": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
